<Window x:Class="CentroOdontologico.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Centro Odontológico" Height="450" Width="600">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Top">
            <Label Content="Paciente:"/>
            <TextBox Name="txtPaciente" Margin="0,0,0,10"/>

            <Label Content="Tratamiento:"/>
            <ComboBox Name="cmbTratamiento" Margin="0,0,0,10">
                <ComboBoxItem Content="Limpieza"/>
                <ComboBoxItem Content="Ortodoncia"/>
                <ComboBoxItem Content="Extracción"/>
            </ComboBox>

            <Label Content="Pieza Dental:"/>
            <ComboBox Name="cmbPieza" Margin="0,0,0,20"/>

            <Button Name="btnCronagrenar" Content="Cronagranar" Click="btnCronagrenar_Click"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <Label Content="Fecha:"/>
            <Calendar Name="calCita"/>
        </StackPanel>

        <ListBox Name="lstCitas" Grid.ColumnSpan="2" Margin="0,200,0,0"/>
    </Grid>
</Window>