<Window x:Class="Semana06.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Semana06"
        mc:Ignorable="d"
        Title="FechaDesplegable" Height="400" Width="600">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="150"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Label Content="Cliente:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox x:Name="txtCliente" Grid.Row="0" Grid.Column="1" Height="25" Margin="2"/>
        <Label Content="Monto a pagar:" Grid.Row="0" Grid.Column="3" VerticalAlignment="Center"/>
        <TextBox x:Name="txtMontoPagarEntrada" Grid.Row="0" Grid.Column="4" Height="25" Margin="2"/>

        <Label Content="Fch. Ven.:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
        <DatePicker x:Name="dpVencimiento" Grid.Row="1" Grid.Column="1" Height="25" Margin="2"/>
        <Label Content="Fch. Pago:" Grid.Row="1" Grid.Column="3" VerticalAlignment="Center"/>
        <DatePicker x:Name="dpPago" Grid.Row="1" Grid.Column="4" Height="25" Margin="2"/>

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button x:Name="btnCantdad" Content="Calcular" Width="80" Click="btnCalcular_Click" Margin="5"/>
            <Button x:Name="btnNuevo" Content="Nuevo" Width="80" Click="btnNuevo_Click" Margin="5"/>
            <Button x:Name="btnFinalizar" Content="Finalizar" Width="80" Click="btnFinalizar_Click" Margin="5"/>
        </StackPanel>

        <Label Content="Días de mora:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox x:Name="txtDiasMora" Grid.Row="3" Grid.Column="1" Background="Gold" Height="25" Margin="2" IsReadOnly="True"/>
        <Label Content="Mora en S/.:" Grid.Row="3" Grid.Column="3" VerticalAlignment="Center"/>
        <TextBox x:Name="txtMoraSoles" Grid.Row="3" Grid.Column="4" Background="Gold" Height="25" Margin="2" IsReadOnly="True"/>

        <Label Content="Mora en %:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox x:Name="txtMoraPorcentaje" Grid.Row="4" Grid.Column="1" Background="Gold" Height="25" Margin="2" IsReadOnly="True"/>
        <Label Content="Monto a pagar:" Grid.Row="4" Grid.Column="3" VerticalAlignment="Center"/>
        <TextBox x:Name="txtTotalPagar" Grid.Row="4" Grid.Column="4" Background="Gold" Height="25" Margin="2" IsReadOnly="True"/>

        <TextBox x:Name="txtFooter" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="5" HorizontalAlignment="Center" Width="200" Height="30" Text="Text Box" VerticalAlignment="Center"/>
    </Grid>
</Window>