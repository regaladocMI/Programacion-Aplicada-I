<Window x:Class="OrdenarCadenas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OrdenarCadenas"
        mc:Ignorable="d"
        Title="OrdenarCadenas" Height="500" Width="780">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="txtCadena" Grid.Row="0" Height="50" TextWrapping="Wrap" AcceptsReturn="True"
                 Text="Liliana Angelina Leticia Amanda Patricia Roxana Luana Laura Kiara Kimberly Syintia Cintia Cecilia Ana Lina Thalia Teresa Pierina"
                 VerticalContentAlignment="Center" Padding="5"/>

        <Button x:Name="btnListar" Grid.Row="1" Content="&lt;&lt;Listar&gt;&gt;" HorizontalAlignment="Left" Width="80" Height="25" Margin="0,10,0,10"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="lstNombres" Grid.Column="0" Margin="0,0,10,0"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Label Content="Letra" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBox x:Name="txtLetra" Width="50" Height="25" TextAlignment="Center" Margin="0,5,0,10"/>
                <Button x:Name="btnPasar" Content="&lt;&lt;Pasar&gt;&gt;" Width="80" Height="25"/>
            </StackPanel>

            <ListBox x:Name="lstFiltrados" Grid.Column="2" Margin="10,0,0,0"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="txtContadorTotal" Grid.Column="0" Width="80" Height="25" HorizontalAlignment="Left" IsReadOnly="True" TextAlignment="Center"/>
            <TextBox x:Name="txtContadorFiltrado" Grid.Column="1" Width="80" Height="25" HorizontalAlignment="Left" IsReadOnly="True" TextAlignment="Center"/>
        </Grid>
    </Grid>
</Window>