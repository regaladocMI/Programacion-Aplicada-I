<Window x:Class="Conecta4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conecta 4 - Jugador vs Máquina"
        Height="700" Width="620"
        WindowStartupLocation="CenterScreen"
        Background="#1E2A38">

    <Window.Resources>
        <Style x:Key="ColumnButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="CeldaEllipseStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Fill" Value="White"/>
            <Setter Property="Stroke" Value="#0D47A1"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="Margin" Value="3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtEstado"
                   Grid.Row="0"
                   Text="Turno: Jugador (Rojo)"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <UniformGrid x:Name="panelColumnas"
                     Grid.Row="1"
                     Rows="1" Columns="7"
                     HorizontalAlignment="Center"
                     Margin="0,0,0,5" Width="478">

            <Button Content="0" Tag="0" Style="{StaticResource ColumnButtonStyle}" Click="BtnColumna_Click"/>
            <Button Content="1" Tag="1" Style="{StaticResource ColumnButtonStyle}" Click="BtnColumna_Click"/>
            <Button Content="2" Tag="2" Style="{StaticResource ColumnButtonStyle}" Click="BtnColumna_Click"/>
            <Button Content="3" Tag="3" Style="{StaticResource ColumnButtonStyle}" Click="BtnColumna_Click"/>
            <Button Content="4" Tag="4" Style="{StaticResource ColumnButtonStyle}" Click="BtnColumna_Click"/>
            <Button Content="5" Tag="5" Style="{StaticResource ColumnButtonStyle}" Click="BtnColumna_Click"/>
            <Button Content="6" Tag="6" Style="{StaticResource ColumnButtonStyle}" Click="BtnColumna_Click"/>
        </UniformGrid>

        <Border Grid.Row="2"
                Background="#1565C0"
                CornerRadius="10"
                Padding="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Top">

            <Grid x:Name="gridTablero">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Row="0" Grid.Column="0" Style="{StaticResource CeldaEllipseStyle}"/>
                <Ellipse Grid.Row="0" Grid.Column="1" Style="{StaticResource CeldaEllipseStyle}"/>
                <Ellipse Grid.Row="0" Grid.Column="2" Style="{StaticResource CeldaEllipseStyle}"/>
                <Ellipse Grid.Row="0" Grid.Column="3" Style="{StaticResource CeldaEllipseStyle}"/>
                <Ellipse Grid.Row="0" Grid.Column="4" Style="{StaticResource CeldaEllipseStyle}"/>
                <Ellipse Grid.Row="0" Grid.Column="5" Style="{StaticResource CeldaEllipseStyle}"/>
                <Ellipse Grid.Row="0" Grid.Column="6" Style="{StaticResource CeldaEllipseStyle}"/>

                <Ellipse Grid.Row="1" Grid.Column="0" Style="{StaticResource CeldaEllipseStyle}"/>
                <Ellipse Grid.Row="1" Grid.Column="1" Style="{StaticResource CeldaEllipseStyle}"/>
                <Ellipse Grid.Row="1" Grid.Column="2" Style="{StaticResource CeldaEllipseStyle}"/>
                <Ellipse Grid.Row="1" Grid.Column="3" Style="{StaticResource CeldaEllipseStyle}"/>
                <Ellipse Grid.Row="1" Grid.Column="4" Style="{StaticResource CeldaEllipseStyle}"/>
                <Ellipse Grid.Row="1" Grid.Column="5" Style="{StaticResource CeldaEllipseStyle}"/>
                <Ellipse Grid.Row="1" Grid.Column="6" Style="{StaticResource CeldaEllipseStyle}"/>

                <Ellipse Grid.Row="2" Grid.Column="0" Style="{StaticResource CeldaEllipseStyle}"/>
                <Ellipse Grid.Row="2" Grid.Column="1" Style="{StaticResource CeldaEllipseStyle}"/>
                <Ellipse Grid.Row="2" Grid.Column="2" Style="{StaticResource CeldaEllipseStyle}"/>
                <Ellipse Grid.Row="2" Grid.Column="3" Style="{StaticResource CeldaEllipseStyle}"/>
                <Ellipse Grid.Row="2" Grid.Column="4" Style="{StaticResource CeldaEllipseStyle}"/>
                <Ellipse Grid.Row="2" Grid.Column="5" Style="{StaticResource CeldaEllipseStyle}"/>
                <Ellipse Grid.Row="2" Grid.Column="6" Style="{StaticResource CeldaEllipseStyle}"/>

                <Ellipse Grid.Row="3" Grid.Column="0" Style="{StaticResource CeldaEllipseStyle}"/>
                <Ellipse Grid.Row="3" Grid.Column="1" Style="{StaticResource CeldaEllipseStyle}"/>
                <Ellipse Grid.Row="3" Grid.Column="2" Style="{StaticResource CeldaEllipseStyle}"/>
                <Ellipse Grid.Row="3" Grid.Column="3" Style="{StaticResource CeldaEllipseStyle}"/>
                <Ellipse Grid.Row="3" Grid.Column="4" Style="{StaticResource CeldaEllipseStyle}"/>
                <Ellipse Grid.Row="3" Grid.Column="5" Style="{StaticResource CeldaEllipseStyle}"/>
                <Ellipse Grid.Row="3" Grid.Column="6" Style="{StaticResource CeldaEllipseStyle}"/>

                <Ellipse Grid.Row="4" Grid.Column="0" Style="{StaticResource CeldaEllipseStyle}"/>
                <Ellipse Grid.Row="4" Grid.Column="1" Style="{StaticResource CeldaEllipseStyle}"/>
                <Ellipse Grid.Row="4" Grid.Column="2" Style="{StaticResource CeldaEllipseStyle}"/>
                <Ellipse Grid.Row="4" Grid.Column="3" Style="{StaticResource CeldaEllipseStyle}"/>
                <Ellipse Grid.Row="4" Grid.Column="4" Style="{StaticResource CeldaEllipseStyle}"/>
                <Ellipse Grid.Row="4" Grid.Column="5" Style="{StaticResource CeldaEllipseStyle}"/>
                <Ellipse Grid.Row="4" Grid.Column="6" Style="{StaticResource CeldaEllipseStyle}"/>

                <Ellipse Grid.Row="5" Grid.Column="0" Style="{StaticResource CeldaEllipseStyle}"/>
                <Ellipse Grid.Row="5" Grid.Column="1" Style="{StaticResource CeldaEllipseStyle}"/>
                <Ellipse Grid.Row="5" Grid.Column="2" Style="{StaticResource CeldaEllipseStyle}"/>
                <Ellipse Grid.Row="5" Grid.Column="3" Style="{StaticResource CeldaEllipseStyle}"/>
                <Ellipse Grid.Row="5" Grid.Column="4" Style="{StaticResource CeldaEllipseStyle}"/>
                <Ellipse Grid.Row="5" Grid.Column="5" Style="{StaticResource CeldaEllipseStyle}"/>
                <Ellipse Grid.Row="5" Grid.Column="6" Style="{StaticResource CeldaEllipseStyle}"/>

            </Grid>
        </Border>

        <!-- Botón para reiniciar partida -->
        <Button x:Name="btnReiniciar"
                Grid.Row="3"
                Content="Reiniciar Juego"
                Width="150" Height="35"
                Margin="0,10,0,0"
                HorizontalAlignment="Center"
                FontWeight="Bold"
                Background="#C62828"
                Foreground="White"
                Click="BtnReiniciar_Click"/>
    </Grid>
</Window>
